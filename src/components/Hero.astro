---
import { portfolio } from '../data/portfolio';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const resumeHref =
  portfolio.resumeUrl && /^https?:/.test(portfolio.resumeUrl)
    ? portfolio.resumeUrl
    : portfolio.resumeUrl
      ? base.replace(/\/$/, '') + '/' + portfolio.resumeUrl.replace(/^\//, '')
      : undefined;
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow">Hi, my name is</p>
    <h1 class="hero__name">{portfolio.name}</h1>
    <h2 class="hero__headline">{portfolio.headline}</h2>
    <p class="hero__tagline">{portfolio.tagline}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">Get in touch</a>
      {
        resumeHref && (
          <a class="btn btn--ghost" href={resumeHref} target="_blank" rel="noopener noreferrer">
            Resume
          </a>
        )
      }
    </div>

    <div class="hero__socials">
      {
        portfolio.socials.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
            <Icon name={s.icon} size={20} />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    background: radial-gradient(
      120% 80% at 50% -10%,
      color-mix(in srgb, var(--accent) 10%, transparent),
      transparent 60%
    );
  }
  .hero__inner {
    padding-block: 3rem;
  }
  .hero__eyebrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .hero__name {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    margin: 0 0 0.25rem;
  }
  .hero__headline {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }
  .hero__tagline {
    max-width: 40rem;
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .hero__socials {
    display: flex;
    gap: 0.75rem;
  }
  .hero__socials a {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .hero__socials a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }
</style>
