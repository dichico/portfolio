---
import { siteConfig } from "../config";
import { lines } from "../network";
import RouteBullet from "./RouteBullet.astro";
import Icon from "./Icon.astro";

const { social } = siteConfig;
const contacts = [
  social.email && { href: `mailto:${social.email}`, icon: "mail", label: `Email ${social.email}`, text: social.email },
  social.linkedin && { href: social.linkedin, icon: "linkedin", label: "LinkedIn profile", text: "linkedin.com/in/dichico" },
  social.github && { href: social.github, icon: "github", label: "GitHub profile", text: "github.com/dichico" },
].filter(Boolean) as { href: string; icon: "mail" | "linkedin" | "github"; label: string; text: string }[];
const external = (href: string) => href.startsWith("http");
---

<section class="band" id="top" aria-labelledby="site-name">
  <div class="band-grid net-row">
    <h1 id="site-name" class="name">{siteConfig.name}</h1>

    <ul class="legend" aria-label="Lines">
      {
        lines.map((line, i) => (
          <li style={`--i:${i}`}>
            <RouteBullet line={line.id} size="md" label={false} />
            <span>{line.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="net-content info">
      <p class="title">{siteConfig.title}</p>

      <div class="interchange">
        <ul class="xfer" aria-label="Contact">
          {
            contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  aria-label={c.label}
                  {...(external(c.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  <Icon name={c.icon} />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="xfer-text">
          <a href="#contact" class="xfer-title">Contact</a>
          <ul class="xfer-list">
            {contacts.map((c) => (
              <li>{c.text}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .band-grid {
    padding-block: 1.75rem 1.5rem;
    row-gap: 1.25rem;
  }

  .band-grid::before {
    display: none;
  }

  @media (min-width: 48rem) {
    .band-grid {
      padding-block: 1.75rem 1.25rem;
      row-gap: 0.75rem;
    }
  }

  .name {
    grid-column: 1 / -1;
    padding-inline: 1.25rem;
    font-size: clamp(2.5rem, 10.5vw, 4.875rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 0.95;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .name {
      padding-left: calc(var(--margin-col) + var(--lane-x0) - var(--bullet) / 2);
    }
  }

  /* Mobile: route bullets read as a legend row. Desktop: they sit on their lanes. */
  .legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0 1.25rem;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-on-ink-mute);
  }

  @media (min-width: 48rem) {
    .legend {
      grid-column: 2;
      grid-row: 2;
      position: relative;
      display: block;
      padding: 0;
      min-height: calc(var(--bullet) + 1.75rem);
    }

    .legend li {
      position: absolute;
      top: 0;
      left: calc(var(--lane-x0) + var(--i) * var(--lane-gap) - var(--bullet) / 2);
      width: var(--bullet);
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.8125rem;
      white-space: nowrap;
    }
  }

  .info {
    grid-column: 1 / -1;
    padding-inline: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  @media (min-width: 48rem) {
    .info {
      grid-column: 3;
      grid-row: 2;
      padding-left: var(--gutter);
      padding-right: 2.5rem;
    }
  }

  .title {
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    font-weight: 500;
    line-height: 1.15;
    padding-top: calc((var(--bullet) - 1.15em) / 2);
  }

  .interchange {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Transfer bullets joined by a connector, like an interchange on the map. */
  .xfer {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .xfer li + li {
    display: flex;
    align-items: center;
  }

  .xfer li + li::before {
    content: "";
    width: 0.875rem;
    height: 0.625rem;
    background: var(--color-paper);
  }

  .xfer a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .xfer a :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .xfer a:hover {
    transform: scale(1.08);
  }

  .xfer a:focus-visible {
    outline-color: var(--color-paper);
  }

  .xfer-title {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .xfer-title:hover {
    text-decoration: underline;
  }

  .xfer-list {
    list-style: none;
    padding: 0;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-ink-mute);
    max-width: 17rem;
    line-height: 1.35;
  }

  @media (min-width: 80rem) {
    .xfer a {
      width: 3.5rem;
      height: 3.5rem;
    }

    .xfer a :global(svg) {
      width: 1.75rem;
      height: 1.75rem;
    }

    .xfer-title {
      font-size: 2rem;
    }
  }
</style>
