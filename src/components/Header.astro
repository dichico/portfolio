---
import { siteConfig } from "../config";

const links = [
  siteConfig.experience?.length && { href: "#experience", label: "Experience" },
  siteConfig.projects?.length && { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  siteConfig.education?.length && { href: "#education", label: "Education" },
].filter(Boolean) as { href: string; label: string }[];
---

<header class="strip">
  <div class="strip-inner">
    <nav aria-label="Sections">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href="#contact" class="contact-link">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .strip {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom: 3px solid var(--color-paper);
  }

  .strip-inner {
    max-width: var(--page-max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
    min-height: 3.25rem;
    padding-inline: 1.25rem;
  }

  @media (min-width: 48rem) {
    .strip-inner {
      min-height: 3.625rem;
      padding-left: calc(var(--margin-col) + 2rem);
      padding-right: 2.5rem;
    }
  }


  nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: -0.25rem;
    padding: 0.25rem;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 47.99rem) {
    nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    }
  }

  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    ul {
      gap: 2.25rem;
    }
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    padding-block: 0.375rem;
  }

  @media (min-width: 48rem) {
    nav a {
      font-size: 1.25rem;
    }
  }

  nav a::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  nav a:hover::before {
    transform: scale(1.6);
  }

  nav a:hover {
    text-decoration: underline;
  }

  .contact-link {
    font-weight: 700;
  }
</style>
