---
import { siteConfig } from "../config";
import { skillLine } from "../network";
import SectionSign from "./SectionSign.astro";
import Lanes from "./Lanes.astro";
import RouteBullet from "./RouteBullet.astro";
---

<section aria-labelledby="about">
  <SectionSign id="about" title="About Me" />

  <div class="about net-row">
    <Lanes row="about" />
    <div class="net-content">
      <p class="about-text">{siteConfig.aboutMe}</p>

      <ul class="skills" aria-label="Skills">
        {
          siteConfig.skills.map((skill) => {
            const line = skillLine[skill];
            return (
              <li>
                {line ? <RouteBullet line={line} /> : <span class="no-line" aria-hidden="true" />}
                <span>{skill}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: 2.5rem 1rem;
  }

  @media (min-width: 48rem) {
    .about {
      padding-block: 3.5rem 1.5rem;
    }
  }

  .about-text {
    max-width: 62ch;
    font-size: clamp(1.125rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    font-weight: 450;
    text-wrap: pretty;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 52rem;
    list-style: none;
    padding: 0;
    border-top: 3px solid var(--color-ink);
  }

  .skills li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .skills li :global(.bullet) {
    font-size: 1.375rem;
  }

  /* Skills off the four lines get a plain black stop. */
  .no-line {
    width: 0.75rem;
    height: 0.75rem;
    margin-inline: 0.0625rem 0.625rem;
    background: var(--color-ink);
    border-radius: 50%;
    flex: none;
  }
</style>
