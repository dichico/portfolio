---
import { siteConfig } from "../config";
import { formatRange } from "../network";
import SectionSign from "./SectionSign.astro";
import Station from "./Station.astro";
import RouteBullet from "./RouteBullet.astro";

const education = siteConfig.education ?? [];
const offset = siteConfig.experience?.length ?? 0;
---

{
  education.length > 0 && (
    <section aria-labelledby="education">
      <SectionSign id="education" title="Education" />

      {education.map((edu, index) => (
        <Station row={`edu:${index}`} number={String(offset + index + 1).padStart(2, "0")} lines={edu.lines}>
          <Fragment slot="head">
            <h3 class="st-name">
              <span>{edu.school}</span>
              {edu.lines.length > 0 && (
                <span class="served">
                  {edu.lines.map((l) => <RouteBullet line={l} />)}
                </span>
              )}
            </h3>
          </Fragment>

          <p class="st-meta">
            <span class="role">{edu.degree}</span>
            <span class="sep" aria-hidden="true">·</span>
            <span class="figure-num">{formatRange(edu.dateRange)}</span>
          </p>

          {edu.achievements.length > 0 && (
            <ul class="ticks">
              {edu.achievements.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          )}
        </Station>
      ))}
    </section>
  )
}
