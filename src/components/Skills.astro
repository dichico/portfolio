---
import { portfolio } from '../data/portfolio';
---

<section id="skills" class="section">
  <div class="container reveal">
    <p class="section__eyebrow">03 — Skills</p>
    <h2 class="section__title">Tools &amp; technologies</h2>

    <div class="skills__grid">
      {
        portfolio.skills.map((group) => (
          <div class="skills__group card">
            <h3 class="skills__category">{group.category}</h3>
            <ul class="skills__tags">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .skills__group {
    padding: 1.25rem 1.5rem;
  }
  .skills__category {
    font-size: 1rem;
    margin: 0 0 0.9rem;
    color: var(--text-muted);
  }
  .skills__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
