---
import { portfolio } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="contact" class="section section--subtle">
  <div class="container contact reveal">
    <p class="section__eyebrow">06 — Contact</p>
    <h2 class="section__title">Get in touch</h2>
    <p class="contact__text text-muted">
      I'm always open to interesting conversations and opportunities. The
      fastest way to reach me is by email — I'll do my best to reply promptly.
    </p>

    <a class="btn btn--primary contact__cta" href={`mailto:${portfolio.email}`}>
      <Icon name="email" size={18} /> {portfolio.email}
    </a>

    <div class="contact__socials">
      {
        portfolio.socials.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
            <Icon name={s.icon} size={20} />
            <span>{s.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    max-width: 42rem;
    text-align: center;
    margin-inline: auto;
  }
  .contact .section__eyebrow,
  .contact .section__title {
    text-align: center;
  }
  .contact__text {
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
  .contact__cta {
    margin-bottom: 2.5rem;
  }
  .contact__socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .contact__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .contact__socials a:hover {
    color: var(--accent);
  }
</style>
