---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import RouteBullet from "./RouteBullet.astro";
import { lines } from "../network";

const { social } = siteConfig;
const contacts = [
  social.email && { href: `mailto:${social.email}`, icon: "mail", text: social.email },
  social.linkedin && { href: social.linkedin, icon: "linkedin", text: "linkedin.com/in/dichico" },
  social.github && { href: social.github, icon: "github", text: "github.com/dichico" },
].filter(Boolean) as { href: string; icon: "mail" | "linkedin" | "github"; text: string }[];
const external = (href: string) => href.startsWith("http");
---

<footer class="end" aria-labelledby="contact">
  <div class="end-grid net-row">
    <div class="interchange" aria-hidden="true">
      <span class="xfer-bar"></span>
      {
        lines.map((line, i) => (
          <span class="slot" style={`--i:${i}`}>
            <RouteBullet line={line.id} size="md" label={false} />
          </span>
        ))
      }
    </div>
    <div class="net-content">
      <h2 id="contact" class="end-title">Contact</h2>

      <ul class="routes">
        {
          contacts.map((c) => (
            <li>
              <a href={c.href} {...(external(c.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                <span class="disc">
                  <Icon name={c.icon} />
                </span>
                <span class="route-text">{c.text}</span>
                {external(c.href) && <span class="sr-only">(opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="colophon">
        <p><strong>{siteConfig.name}</strong> · {siteConfig.title}</p>
        <p class="figure-num">© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .end {
    background: var(--color-ink);
    color: var(--color-paper);
    border-top: 3px solid var(--color-ink);
    box-shadow: inset 0 0.5rem 0 var(--color-ink), inset 0 0.6875rem 0 var(--color-paper);
  }

  .end-grid {
    padding-block: 4rem 2.5rem;
  }

  .end-grid::before {
    display: none;
  }

  @media (min-width: 48rem) {
    .end-grid {
      padding-block: 6rem 3rem;
    }
  }

  .end-grid > .net-content {
    grid-column: 1 / -1;
    padding-inline: 1.25rem;
  }

  /* Every line's last transfer: the four bullets joined into one interchange. */
  .interchange {
    grid-column: 1 / -1;
    position: relative;
    display: flex;
    gap: 0.5rem;
    margin: 0 1.25rem 1.5rem;
    width: max-content;
  }

  .xfer-bar {
    position: absolute;
    left: calc(var(--bullet) / 2);
    right: calc(var(--bullet) / 2);
    top: 50%;
    height: 0.5rem;
    transform: translateY(-50%);
    background: var(--color-paper);
  }

  .slot {
    position: relative;
    display: flex;
  }

  @media (min-width: 48rem) {
    .interchange {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      display: block;
      width: auto;
      height: var(--bullet);
      margin: calc((clamp(2.75rem, 8vw, 6rem) * 0.9 - var(--bullet)) / 2) 0 0;
    }

    .xfer-bar {
      left: var(--lane-x0);
      right: auto;
      width: calc(3 * var(--lane-gap));
      height: 0.625rem;
    }

    .slot {
      position: absolute;
      top: 0;
      left: calc(var(--lane-x0) + var(--i) * var(--lane-gap) - var(--bullet) / 2);
    }
  }

  @media (min-width: 48rem) {
    .end-grid > .net-content {
      grid-column: 3;
      grid-row: 1;
      padding-left: var(--gutter);
    }
  }

  .end-title {
    font-size: clamp(2.75rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  /* Transfers stacked as one interchange: discs joined by a connector. */
  .routes {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3rem);
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .routes::before {
    content: "";
    position: absolute;
    left: calc(1.5rem - 0.3125rem);
    top: 1.5rem;
    bottom: 1.5rem;
    width: 0.625rem;
    background: var(--color-paper);
  }

  .routes a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    font-size: clamp(1.125rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .disc {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .disc :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .routes a:hover .route-text {
    text-decoration: underline;
  }

  .routes a:hover .disc {
    transform: scale(1.08);
  }

  .colophon {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-on-ink-rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.9375rem;
    color: var(--color-on-ink-mute);
  }

  .colophon strong {
    color: var(--color-paper);
    font-weight: 700;
  }
</style>
