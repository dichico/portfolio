---
import Lanes from "./Lanes.astro";

interface Props {
  id: string;
  title: string;
  draw?: boolean;
  /** First sign under the band sits closer to it. */
  first?: boolean;
  /** Keep the heading for assistive tech but leave the network uninterrupted. */
  hidden?: boolean;
}

const { id, title, draw = false, first = false, hidden = false } = Astro.props;
---

<div class:list={["sign-row net-row", { first, hidden }]}>
  <Lanes row={`sign:${id}`} draw={draw} />
  <div class="net-content">
    <h2 id={id} class:list={[hidden ? "sr-only" : "sign"]}>{title}</h2>
  </div>
</div>

<style>
  .sign-row {
    padding-top: 3.5rem;
  }

  @media (min-width: 48rem) {
    .sign-row {
      padding-top: 6rem;
    }

    .sign-row.first {
      padding-top: 3.5rem;
    }
  }

  .sign-row.hidden {
    padding-top: 0.5rem;
  }

  /* A station name sign: white grotesk on black enamel with the signage stripe. */
  .sign {
    display: inline-block;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 0.875rem 1.25rem 0.75rem;
    box-shadow: inset 0 0.3125rem 0 var(--color-ink), inset 0 0.5rem 0 var(--color-paper);
  }

  @media (min-width: 48rem) {
    .sign {
      font-size: 2.25rem;
      padding: 1.25rem 1.75rem 1rem;
    }
  }
</style>
