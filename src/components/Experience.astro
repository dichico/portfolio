---
import { siteConfig } from "../config";
import { formatRange } from "../network";
import SectionSign from "./SectionSign.astro";
import Station from "./Station.astro";
import RouteBullet from "./RouteBullet.astro";

const experience = siteConfig.experience ?? [];
---

{
  experience.length > 0 && (
    <section aria-labelledby="experience">
      <SectionSign id="experience" title="Experience" draw hidden />

      {experience.map((exp, index) => (
        <Station row={`exp:${index}`} number={String(index + 1).padStart(2, "0")} lines={exp.lines} draw={index === 0} drawDelay={260} compact={index === 0}>
          <Fragment slot="head">
            <h3 class="st-name">
              <span>{exp.company}</span>
              <span class="served">
                {exp.lines.map((l) => <RouteBullet line={l} />)}
              </span>
            </h3>
          </Fragment>

          <p class="st-meta">
            <span class="role">{exp.title}</span>
            <span class="sep" aria-hidden="true">·</span>
            <span class="figure-num">{formatRange(exp.dateRange)}</span>
          </p>

          {"figures" in exp && exp.figures && (
            <div class="platform-sign">
              <p class="lead">
                <span class="lead-value figure-num">{exp.figures.lead.value}</span>
                <span class="lead-label">{exp.figures.lead.label}</span>
              </p>
              <dl class="service">
                {exp.figures.service.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd class="figure-num">
                      {"line" in f && f.line && <RouteBullet line={f.line} />}
                      {f.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {"highlight" in exp && exp.highlight && <p class="highlight">{exp.highlight}</p>}

          <ul class="ticks">
            {exp.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </Station>
      ))}
    </section>
  )
}

<style>
  /* Platform sign: the system's posted figures. */
  .platform-sign {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .lead {
    display: flex;
    flex-direction: column;
  }

  .lead-value {
    font-size: clamp(3.75rem, 14.5vw, 11rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.86;
    margin-left: -0.04em;
  }

  .lead-label {
    margin-top: clamp(0.5rem, 1.2vw, 1rem);
    font-size: clamp(1.25rem, 2.6vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .service {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    padding-top: 0.875rem;
    border-top: 3px solid var(--color-ink);
  }

  @media (min-width: 64rem) {
    .service {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .service dd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .service dd :global(.bullet) {
    font-size: 0.5em;
  }

  .service dt {
    margin-top: 0.375rem;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 500;
    color: var(--color-mute);
  }

  .highlight {
    margin-top: 1.25rem;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

</style>
