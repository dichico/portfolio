---
import { portfolio } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="projects" class="section section--subtle">
  <div class="container reveal">
    <p class="section__eyebrow">04 — Projects</p>
    <h2 class="section__title">Things I've built</h2>

    <div class="projects__grid">
      {
        portfolio.projects.map((project) => (
          <article class="project card">
            <div class="project__body">
              <div class="project__top">
                <Icon name="website" size={26} class="project__folder" />
                <div class="project__links">
                  {project.links.map((link) => (
                    <a href={link.href} aria-label={`${project.name} — ${link.label}`} target="_blank" rel="noopener noreferrer">
                      {link.label === 'Code' ? <Icon name="github" size={18} /> : <Icon name="website" size={18} />}
                    </a>
                  ))}
                </div>
              </div>
              <h3 class="project__name">{project.name}</h3>
              <p class="project__desc text-muted">{project.description}</p>
            </div>
            <ul class="project__tech">
              {project.tech.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .project:hover {
    transform: translateY(-4px);
  }
  .project__body {
    flex: 1;
  }
  .project__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .project__folder {
    color: var(--accent);
  }
  .project__links {
    display: flex;
    gap: 0.5rem;
  }
  .project__links a {
    display: inline-flex;
    color: var(--text-muted);
  }
  .project__links a:hover {
    color: var(--accent);
  }
  .project__name {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }
  .project__desc {
    font-size: 0.95rem;
    margin: 0;
  }
  .project__tech {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
</style>
