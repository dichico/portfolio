---
import { siteConfig } from "../config";
import SectionSign from "./SectionSign.astro";
import Station from "./Station.astro";
import RouteBullet from "./RouteBullet.astro";
import Icon from "./Icon.astro";

const projects = siteConfig.projects ?? [];
---

{
  projects.length > 0 && (
    <section aria-labelledby="projects">
      <SectionSign id="projects" title="Projects" />

      {projects.map((project, index) => (
        <Station row={`proj:${index}`} lines={project.lines} kind="local">
          <Fragment slot="head">
            <h3 class="st-name">
              {project.link ? (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="p-link">
                  {project.name}
                  <Icon name="arrow-up-right" class="p-arrow" />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span>{project.name}</span>
              )}
              {project.lines.length > 0 && (
                <span class="served">
                  {project.lines.map((l) => <RouteBullet line={l} />)}
                </span>
              )}
            </h3>
          </Fragment>

          <p class="p-desc">{project.description}</p>

          {project.skills?.length > 0 && (
            <ul class="p-skills" aria-label="Technologies">
              {project.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )}
        </Station>
      ))}
    </section>
  )
}

<style>
  .p-link {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 0.1em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-link:hover {
    background-size: 100% 0.1em;
  }

  .p-link :global(.p-arrow) {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-left: 0.15em;
    vertical-align: -0.04em;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-link:hover :global(.p-arrow) {
    transform: translate(0.08em, -0.08em);
  }

  .p-desc {
    margin-top: 0.875rem;
    max-width: 65ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-mute);
  }

  @media (min-width: 48rem) {
    .p-desc {
      font-size: 1.1875rem;
    }
  }

  .p-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin-top: 1rem;
    list-style: none;
    padding: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .p-skills li:not(:last-child)::after {
    content: "/";
    margin-inline: 0.625rem;
    font-weight: 400;
    color: var(--color-faint);
  }
</style>
